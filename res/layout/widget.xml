<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/wbg" android:padding="10dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/prev" android:layout_width="34dp" android:layout_height="30dp" android:gravity="center"
        android:text="‹" android:textSize="22sp" android:textColor="@color/wmuted"/>
    <LinearLayout android:id="@+id/head" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
      <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:textSize="15sp" android:textStyle="bold" android:textColor="@color/wink" android:maxLines="1"/>
      <TextView android:id="@+id/stats" android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:textSize="11sp" android:textColor="@color/wmuted" android:maxLines="1"/>
    </LinearLayout>
    <TextView android:id="@+id/next" android:layout_width="34dp" android:layout_height="30dp" android:gravity="center"
        android:text="›" android:textSize="22sp" android:textColor="@color/wmuted"/>
  </LinearLayout>
  <ImageView android:id="@+id/grid" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
      android:layout_marginTop="4dp" android:scaleType="fitCenter"/>
  <LinearLayout android:id="@+id/btns" android:layout_width="match_parent" android:layout_height="32dp" android:orientation="horizontal" android:layout_marginTop="6dp">
    <TextView android:id="@+id/bLeave" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center"
        android:text="+ Leave" android:textSize="12sp" android:textStyle="bold" android:textColor="#0d7a84"/>
    <TextView android:id="@+id/bLate" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center"
        android:text="+ Late" android:textSize="12sp" android:textStyle="bold" android:textColor="#c27a10"/>
    <TextView android:id="@+id/bOt" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center"
        android:text="+ OT" android:textSize="12sp" android:textStyle="bold" android:textColor="#6f60d8"/>
  </LinearLayout>
</LinearLayout>
